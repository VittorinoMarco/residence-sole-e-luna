# Copia in .env e compila. NON committare .env.
# Mai inventare ID: lascia vuoto finché il cliente non li fornisce.

# Dominio preferito (da decidere: con o senza www)
SITE_URL=https://www.residencesoleluna.it

# Google
GTM_ID=
GA4_MEASUREMENT_ID=

# Form preventivo (sezione 8 del brief)
FORM_TO_EMAIL=            # casella OVH del cliente che riceve i preventivi
FORM_FROM_EMAIL=          # mittente verificato del provider email
EMAIL_PROVIDER_API_KEY=   # solo lato server, mai nel browser

# Antispam (opzionale)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
