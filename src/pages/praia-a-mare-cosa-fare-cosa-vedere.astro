---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextPage from '../components/NextPage.astro';
import CloseBand from '../components/CloseBand.astro';
import { activities, paths, photos } from '../data/site';

const path = paths.activities;
---

<Base
  title="Cosa fare a Praia a Mare: attività | Residence Soleluna"
  description="Rafting, parapendio, quad e diving a Praia a Mare: il Residence Soleluna è convenzionato con centri sportivi esterni."
  path={path}
>
  <PageHero
    title="Cosa fare a Praia a Mare"
    lede="Il residence è convenzionato con centri sportivi esterni per rafting, parapendio, quad, diving e scuola sub."
    crumbs={[
      { href: '/', label: 'Home' },
      { href: paths.town, label: 'Praia a Mare' },
      { label: 'Attività' },
    ]}
    photo={photos.lido}
    focus="50% 30%"
  />

  <section class="section">
    <div class="wrap">
      <ul class="cards">
        {
          activities.map((activity) => (
            <li class="card reveal">
              <h2>{activity.title}</h2>
              <p>{activity.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="note" style="margin-top: 24px">
        Per prenotare un’attività chiedi al residence: <a href={`${paths.contact}#preventivo`}>scrivici</a> o chiama il
        <a href="tel:+390985779029">0985 779029</a>.
      </p>
    </div>
  </section>

  <NextPage to="activities" />

  <CloseBand />
</Base>
