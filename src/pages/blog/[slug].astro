---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import CloseBand from '../../components/CloseBand.astro';
import { dateLabel, minutes, posts } from '../../data/posts';
import { site } from '../../data/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const path = `/blog/${post.slug}`;
const slug = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const toc = post.body.flatMap((block) => (block.type === 'h2' ? [{ text: block.text, id: slug(block.text) }] : []));
const related = posts.filter((item) => item.slug !== post.slug).slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.date,
  image: new URL(post.photo.src, site.url).href,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(path, site.url).href,
};
---

<Base title={`${post.title} | Residence Soleluna`} description={post.excerpt} path={path} jsonLd={jsonLd}>
  <section class="post-hero">
    <div class="wrap">
      <a class="back" href="/blog">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 10H4M9 4l-6 6 6 6" /></svg>
        Tutti gli articoli
      </a>
      <p class="chip">{post.category}</p>
      <h1>{post.title}</h1>
      <p class="post-info">{dateLabel(post.date)} · {minutes(post)} min di lettura</p>
      <div class="post-cover mask mask-soft no-parallax">
        <img src={post.photo.src} alt={post.photo.alt} fetchpriority="high" style={`object-position:${post.focus}`} />
      </div>
    </div>
  </section>

  <section class="section post-body">
    <div class="wrap post-layout">
      {
        toc.length > 0 && (
          <nav class="toc" aria-label="Indice dell’articolo">
            <p class="toc-title">In questo articolo</p>
            <ol>
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <article class="prose post-prose">
        {
          post.body.map((block) =>
            block.type === 'h2' ? (
              <h2 id={slug(block.text)} class="no-split">{block.text}</h2>
            ) : block.type === 'ul' ? (
              <ul class="list-dash">{block.items.map((item) => <li>{item}</li>)}</ul>
            ) : (
              <p set:html={block.text} />
            ),
          )
        }
      </article>
    </div>
  </section>

  <section class="section section-sand" aria-labelledby="altri-articoli">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Continua a leggere</p>
        <h2 id="altri-articoli">Altri articoli</h2>
      </header>
      <ul class="post-grid two">
        {related.map((item) => <PostCard post={item} />)}
      </ul>
    </div>
  </section>

  <CloseBand />
</Base>
