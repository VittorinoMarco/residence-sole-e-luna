---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { photos, site } from '../data/site';
---

<Base
  title="Pagina non trovata | Residence Soleluna"
  description="Questa pagina non c’è. Torna alla home del Residence Soleluna o chiama il residence."
  path="/404"
>
  <PageHero
    title="Questa pagina non c’è"
    lede="Il percorso non corrisponde a una pagina del residence."
    crumbs={[
      { href: '/', label: 'Home' },
      { label: 'Pagina non trovata' },
    ]}
    photo={photos.golfo}
    focus="50% 60%"
  />
  <section class="section">
    <div class="wrap">
      <p class="actions" style="justify-content:center">
        <a class="btn" href="/">Torna alla home</a>
        <a class="btn btn-ghost" href={site.phones[0].href}>Chiama</a>
      </p>
    </div>
  </section>
</Base>
