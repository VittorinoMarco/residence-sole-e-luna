---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Pagina non trovata | Residence Soleluna"
  description="Questa pagina non c’è. Torna alla home del Residence Soleluna o chiama il residence."
  path="/404"
>
  <section class="page-hero tone-paper">
    <div class="wrap">
      <h1>Questa pagina non c’è</h1>
      <p class="lede">Il percorso non corrisponde a una pagina del residence.</p>
      <p class="actions">
        <a class="btn" href="/">Torna alla home</a>
        <a class="btn btn-sea" href={site.phones[0].href}>Chiama</a>
      </p>
    </div>
  </section>
</Base>
