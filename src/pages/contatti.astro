---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { paths, site } from '../data/site';

const path = paths.contact;
const title = 'Contatti e preventivo | Residence Soleluna';
const description =
  'Telefono, email e richiesta di preventivo del Residence Soleluna, Via G. Carducci 38, Praia a Mare.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: ['+390985779029', '+393388750991'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.cap,
    addressLocality: 'Praia a Mare',
    addressRegion: 'CS',
    addressCountry: 'IT',
  },
};
---

<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <PageHero
    title="Contatti"
    lede="Chiamaci o scrivici per informazioni e per un preventivo."
    tone="ink"
    crumbs={[
      { href: '/', label: 'Home' },
      { label: 'Contatti' },
    ]}
  />

  <section class="section section-sand" id="preventivo" aria-labelledby="titolo-preventivo">
    <div class="wrap quote-grid">
      <div class="quote-side reveal">
        <h2 id="titolo-preventivo">Richiedi un preventivo</h2>
        <div class="prose">
          <p>Indica le date e quante persone siete. Se preferisci, chiama.</p>
        </div>
        <p style="margin-top: 32px">
          <a class="phone-link" href={site.phones[0].href}>{site.phones[0].label}</a>
          <a class="phone-link" href={site.phones[1].href}>{site.phones[1].label}</a>
        </p>
        <address>
          {site.address.street}<br />
          {site.address.cap} {site.address.city}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
        <p class="actions">
          <a class="btn btn-ghost" href={site.map} rel="noopener noreferrer">Apri la mappa</a>
        </p>
      </div>
      <div class="reveal">
        <QuoteForm needsType />
      </div>
    </div>
  </section>
</Base>
