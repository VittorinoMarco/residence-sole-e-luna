---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ResidenceMap from '../components/ResidenceMap.astro';
import PlacesRail from '../components/PlacesRail.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import PostCard from '../components/PostCard.astro';
import { apartments, chapters, homeIntro, paths, photos, services, site } from '../data/site';
import { posts } from '../data/posts';

const title = 'Residence Soleluna a Praia a Mare | Piscina, lido e appartamenti';
const description =
  'Residence Soleluna a Praia a Mare: appartamenti con piscina, lido convenzionato Point Break e navetta per la spiaggia. Chiedi un preventivo.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: ['+390985779029', '+393388750991'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.cap,
    addressLocality: 'Praia a Mare',
    addressRegion: 'CS',
    addressCountry: 'IT',
  },
};

---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="opening" data-shrink>
    <div class="opening-sticky">
      <div class="shrink-frame" data-shrink-frame>
        <img src={photos.golfo.src} alt={photos.golfo.alt} fetchpriority="high" />
      </div>
      <div class="intro" data-intro>
        <p class="kicker">Residence a Praia a Mare</p>
        <h1>
          <span class="sole">Sole</span> <span class="luna">Luna</span>
        </h1>
        <p class="lede">{homeIntro}</p>
        <p class="actions">
          <a class="btn" href="#preventivo">Richiedi un preventivo</a>
          <a class="btn btn-ghost" href={site.phones[0].href}>Chiama</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section services" aria-labelledby="titolo-servizi">
    <div class="wrap services-grid">
      <header class="services-head reveal">
        <p class="kicker">I nostri servizi</p>
        <h2 id="titolo-servizi">Per una vacanza di qualità</h2>
      </header>
      {
        services.map((service, index) => (
          <article class={`service-card reveal pos-${index + 1}`} data-drift={[0, -30, -30, -60, -60][index]}>
            <Icon name={service.icon} size={56} />
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a class="more" href={service.href}>Vai al servizio</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="expand" data-expand aria-labelledby="titolo-case">
    <div class="expand-frame" data-expand-frame>
      <img src={photos.giorno.src} alt={photos.giorno.alt} loading="lazy" />
    </div>
    <div class="wrap expand-copy" data-expand-copy>
      <p class="kicker">Il residence</p>
      <h2 id="titolo-case" class="no-split">Case vacanze con piscina, sul golfo di Policastro</h2>
      <p class="lede">
        Trentasei appartamenti arredati intorno alla piscina e al solarium, in una posizione tranquilla e panoramica.
        Il centro di Praia a Mare e la spiaggia sono a circa 1 km.
      </p>
      <p class="actions">
        <a class="btn" href={paths.residence}>Il residence</a>
        <a class="btn btn-light" href={paths.apartments}>Gli appartamenti</a>
      </p>
    </div>
  </section>

  <section class="reel" data-reel aria-label="Piscina, sera, lido e casa">
    {
      chapters.map((chapter) => (
        <article class="reel-photo" data-reel-photo id={chapter.id} style={`--focus:${chapter.focus}`}>
          <img src={chapter.photo.src} alt={chapter.photo.alt} loading="lazy" />
          <div class="reel-copy">
            <h2>{chapter.word}</h2>
            <p>{chapter.text}</p>
            <p class="actions">
              <a class="btn btn-light" href={chapter.href}>{chapter.link}</a>
            </p>
          </div>
        </article>
      ))
    }
    <div class="reel-words" data-reel-words aria-hidden="true">
      {chapters.map((chapter) => <span class="reel-word">{chapter.word}</span>)}
    </div>
  </section>

  <section class="section" aria-labelledby="titolo-appartamenti">
    <div class="wrap">
      <header class="section-head reveal">
        <h2 id="titolo-appartamenti">Gli appartamenti</h2>
        <p class="lede">Bilocali, trilocali e quadrilocali, con cucina, aria condizionata nel soggiorno e terrazzo attrezzato.</p>
      </header>
      <ul class="stay-grid">
        {
          apartments.map((item) => (
            <li class="stay-card reveal">
              <div class="mask mask-arch">
                <img src={item.photo.src} alt={item.photo.alt} loading="lazy" />
              </div>
              <div>
                <span class="beds">{item.beds}</span>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <a class="more" href={paths.apartments}>Scheda completa</a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-sand" aria-labelledby="titolo-mappa">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Piantina</p>
        <h2 id="titolo-mappa">Il residence, punto per punto</h2>
        <p class="lede">Tocca i numeri sulla foto per vedere cosa c’è. Con «Il golfo» si passa alla vista dall’alto su Praia a Mare.</p>
      </header>
      <div class="reveal">
        <ResidenceMap />
      </div>
    </div>
  </section>

  <section class="section section-mist rail-section" aria-labelledby="titolo-praia">
    <div class="wrap rail-head">
      <header class="reveal">
        <p class="kicker">Nei dintorni</p>
        <h2 id="titolo-praia">Praia a Mare e dintorni</h2>
        <div class="prose">
          <p>
            Il mare incontaminato, l’Isola Dino con le sue grotte, il Viale delle Libertà e più di 4 km di lungomare.
            Dal residence si vede il golfo e, dall’alto, l’Isola Dino.
          </p>
        </div>
      </header>
      <p class="actions reveal">
        <a class="btn btn-sea" href={paths.town}>Cosa vedere</a>
        <a class="btn btn-ghost" href={paths.activities}>Attività</a>
      </p>
    </div>
    <PlacesRail />
  </section>

  <section class="section" aria-labelledby="titolo-blog">
    <div class="wrap">
      <header class="section-head section-head-row reveal">
        <div>
          <p class="kicker">Diario dal golfo</p>
          <h2 id="titolo-blog">Dal blog</h2>
        </div>
        <a class="btn btn-ghost" href={paths.blog}>Tutti gli articoli</a>
      </header>
      <ul class="post-grid three">
        {posts.slice(0, 3).map((post) => <PostCard post={post} />)}
      </ul>
    </div>
  </section>

  <Faq tag="home" />

  <Reviews tone="mist" />

  <section class="section section-sand" id="preventivo" aria-labelledby="titolo-preventivo">
    <div class="wrap quote-grid">
      <div class="quote-side reveal">
        <h2 id="titolo-preventivo">Richiedi un preventivo</h2>
        <div class="prose">
          <p>Scrivici le date e quante persone siete. Ti rispondiamo con il preventivo, oppure chiamaci.</p>
        </div>
        <p style="margin-top: 32px">
          <a class="phone-link" href={site.phones[0].href}>{site.phones[0].label}</a>
          <a class="phone-link" href={site.phones[1].href}>{site.phones[1].label}</a>
        </p>
        <address>
          {site.address.street}, {site.address.cap} {site.address.city}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </div>
      <div class="reveal">
        <QuoteForm />
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home-motion';
</script>
