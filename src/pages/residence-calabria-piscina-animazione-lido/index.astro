---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import NextPage from '../../components/NextPage.astro';
import CloseBand from '../../components/CloseBand.astro';
import Icon from '../../components/Icon.astro';
import { nightPool, paths, photos, type IconName } from '../../data/site';

const title = 'Piscina, animazione e lido | Residence Soleluna';
const description =
  'Servizi del Residence Soleluna a Praia a Mare: piscina per gli ospiti, animazione, lido Point Break, navetta, parcheggio e spazio giochi.';
const path = paths.services;

const blocks: {
  id: string;
  title: string;
  icon: IconName;
  paragraphs: string[];
  href?: string;
  link?: string;
  photo?: { src: string; alt: string };
}[] = [
  {
    id: 'piscina',
    title: 'Piscina',
    icon: 'pool',
    paragraphs: [
      'Situata nella parte centrale del residence, è riservata ai soli ospiti. Ha un ampio solarium con chiosco bar, lettini, ombrelloni e docce, oltre a un tavolo da ping-pong e al calcio balilla gratuiti.',
    ],
    href: paths.pool,
    link: 'La piscina',
    photo: photos.giorno,
  },
  {
    id: 'animazione',
    title: 'Animazione',
    icon: 'star',
    paragraphs: [
      'Tutti i giorni, per adulti e bambini, con personale professionale e mai invadente: spettacoli, miniclub, cabaret, serate giochi, karaoke, aquagym e balli di gruppo.',
      'Per garantire una vacanza rilassante, l’animazione non c’è durante gli orari di riposo.',
    ],
    photo: photos.animazione,
  },
  {
    id: 'lido',
    title: 'Lido convenzionato e navetta',
    icon: 'umbrella',
    paragraphs: [
      'Il servizio spiaggia è in convenzione con il lido Point Break, sulla spiaggia di Praia a Mare. Una navetta gratuita porta alla spiaggia e riporta al residence: tutti i giorni dalle 9.00 alle 13.00 e dalle 15.30 alle 19.30, ogni 30 minuti.',
    ],
    href: paths.beach,
    link: 'Lido e navetta',
    photo: photos.lido,
  },
  {
    id: 'giochi',
    title: 'Area giochi e barbecue',
    icon: 'flame',
    paragraphs: [
      'Un’area giochi attrezzata con altalene, dondoli e scivoli, riservata ai più piccoli. Un’area con tre barbecue, gazebo, tavoli e sedie, e un chiosco bar, per le serate in compagnia.',
    ],
  },
  {
    id: 'parcheggio',
    title: 'Parcheggio e lavanderia',
    icon: 'car',
    paragraphs: [
      'All’arrivo, con le chiavi dell’appartamento, ogni ospite riceve un telecomando per il cancello carrabile e parcheggia l’auto all’interno del residence. C’è una lavanderia self-service a gettoni, con asse e ferro da stiro.',
    ],
    href: paths.parking,
    link: 'Parcheggio e lavanderia',
  },
];
---

<Base title={title} description={description} path={path}>
  <PageHero
    title="Servizi"
    lede="Piscina, animazione, lido, navetta, parcheggio e area giochi: quello che c’è nel residence e intorno, per una vacanza di qualità."
    crumbs={[
      { href: '/', label: 'Home' },
      { label: 'Servizi' },
    ]}
    photo={nightPool[0]}
    focus="50% 55%"
  />

  <nav class="subnav" aria-label="In questa pagina">
    <ul class="wrap">
      <li><a href="#piscina">Piscina</a></li>
      <li><a href="#animazione">Animazione</a></li>
      <li><a href="#lido">Lido e navetta</a></li>
      <li><a href="#giochi">Giochi e barbecue</a></li>
      <li><a href="#parcheggio">Parcheggio</a></li>
    </ul>
  </nav>

  <section class="section">
    <div class="wrap">
      {
        blocks.map((block, index) => (
          <article
            id={block.id}
            class:list={['service-row', 'reveal', index % 2 === 1 && 'flip', !block.photo && 'no-photo']}
          >
            <div>
              <Icon name={block.icon} />
              <h2>{block.title}</h2>
              <div class="prose">
                {block.paragraphs.map((text) => <p>{text}</p>)}
              </div>
              {block.href && block.link && (
                <p class="actions">
                  <a class="btn btn-ghost" href={block.href}>{block.link}</a>
                </p>
              )}
            </div>
            {block.photo && (
              <div class="mask mask-soft">
                <img src={block.photo.src} alt={block.photo.alt} loading="lazy" />
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <Faq tag="pool" />

  <NextPage to="services" />

  <CloseBand />
</Base>
