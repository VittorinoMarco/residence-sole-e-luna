---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CloseBand from '../../components/CloseBand.astro';
import Icon from '../../components/Icon.astro';
import { paths, photos } from '../../data/site';

const path = paths.beach;
---

<Base
  title="Lido convenzionato e navetta | Residence Soleluna"
  description="Servizio spiaggia in convenzione con il lido Point Break di Praia a Mare, con navetta gratuita dal Residence Soleluna."
  path={path}
>
  <PageHero
    title="Lido e navetta"
    lede="Servizio spiaggia con navetta privata, in convenzione con il lido Point Break, sulla spiaggia di Praia a Mare."
    tone="mist"
    crumbs={[
      { href: '/', label: 'Home' },
      { href: paths.services, label: 'Servizi' },
      { label: 'Lido e navetta' },
    ]}
    photo={photos.lido}
  />

  <section class="section">
    <div class="wrap">
      <ul class="cards">
        <li class="card reveal">
          <Icon name="umbrella" />
          <h2>Spiaggia attrezzata</h2>
          <p>
            Il lido Point Break è adatto a tutti, anche alle famiglie con bambini: è l’ideale per una vacanza all’insegna
            del relax, del divertimento e dello sport.
          </p>
        </li>
        <li class="card reveal">
          <Icon name="bus" />
          <h2>Servizio navetta</h2>
          <p>
            Una comoda navetta, da e per la spiaggia, è a disposizione gratuitamente tutti i giorni dalle 9.00 alle 13.00
            e dalle 15.30 alle 19.30, ogni 30 minuti.
          </p>
        </li>
      </ul>
      <p class="note" style="margin-top: 24px">
        Il residence è a circa 1 km dal centro e dalla spiaggia di sabbia e ghiaia.
      </p>
    </div>
  </section>

  <CloseBand />
</Base>
