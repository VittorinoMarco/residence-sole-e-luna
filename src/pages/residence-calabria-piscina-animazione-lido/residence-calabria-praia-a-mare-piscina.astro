---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CloseBand from '../../components/CloseBand.astro';
import Missing from '../../components/Missing.astro';
import { photos } from '../../data/site';

const path = '/residence-calabria-piscina-animazione-lido/residence-calabria-praia-a-mare-piscina';
---

<Base
  title="Piscina del Residence Soleluna a Praia a Mare"
  description="Piscina riservata agli ospiti del Residence Soleluna, con chiosco bar, lettini, ombrelloni e docce."
  path={path}
>
  <PageHero
    title="Piscina"
    lede="La piscina è riservata agli ospiti. Ci sono chiosco bar, lettini, ombrelloni e docce. Il residence ha anche il solarium."
    tone="cielo"
    crumbs={[
      { href: '/', label: 'Home' },
      { href: '/residence-calabria-piscina-animazione-lido', label: 'Servizi' },
      { label: 'Piscina' },
    ]}
    photo={photos.piscina}
  />
  <section class="stack">
    <div class="wrap">
      <Missing subject="la pagina della piscina" />
    </div>
  </section>
  <CloseBand />
</Base>
