---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import NextPage from '../../components/NextPage.astro';
import CloseBand from '../../components/CloseBand.astro';
import { nightPool, paths, photos } from '../../data/site';

const path = paths.pool;
---

<Base
  title="Piscina del Residence Soleluna a Praia a Mare"
  description="Piscina riservata agli ospiti del Residence Soleluna, con chiosco bar, lettini, ombrelloni e docce."
  path={path}
>
  <PageHero
    title="Piscina"
    lede="Situata nella parte centrale del residence, è riservata ai soli ospiti. Ha un ampio solarium con chiosco bar, lettini, ombrelloni e docce, oltre a un tavolo da ping-pong e al calcio balilla gratuiti."
    crumbs={[
      { href: '/', label: 'Home' },
      { href: paths.services, label: 'Servizi' },
      { label: 'Piscina' },
    ]}
    photo={photos.giorno}
    focus="50% 60%"
  />

  <section class="section">
    <div class="wrap split">
      <div class="reveal">
        <h2>Una piscina privata per gli ospiti</h2>
        <ul class="list-dash">
          <li>Un assistente alla balneazione è sempre presente e vigile, per un uso corretto e sicuro.</li>
          <li>La parte meno profonda è riservata ai più piccoli, che apprezzano molto la piscina.</li>
          <li>Durante la settimana, in orari stabiliti, personale qualificato organizza lezioni di aquagym e aerobica o balli di gruppo.</li>
          <li>Una volta a settimana la piscina resta aperta per il bagno di mezzanotte.</li>
        </ul>
        <p class="actions">
          <a class="btn" href={`${paths.contact}#preventivo`}>Richiedi un preventivo</a>
        </p>
      </div>
      <div class="mask mask-soft reveal">
        <img src={photos.piscina.src} alt={photos.piscina.alt} loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section-ink" aria-labelledby="titolo-sera">
    <div class="wrap">
      <header class="section-head reveal">
        <h2 id="titolo-sera">La piscina di sera</h2>
      </header>
      <div class="gallery">
        {nightPool.map((photo) => <img class="reveal" src={photo.src} alt={photo.alt} loading="lazy" />)}
      </div>
    </div>
  </section>

  <Faq tag="pool" />

  <NextPage to="pool" />

  <CloseBand />
</Base>
