---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ResidenceMap from '../../components/ResidenceMap.astro';
import MediaGroup from '../../components/MediaGroup.astro';
import Faq from '../../components/Faq.astro';
import Reviews from '../../components/Reviews.astro';
import NextPage from '../../components/NextPage.astro';
import CloseBand from '../../components/CloseBand.astro';
import Icon from '../../components/Icon.astro';
import { paths, photos } from '../../data/site';

const title = 'Il residence a Praia a Mare | Soleluna';
const description =
  'Residence Soleluna, recente costruzione a Praia a Mare: piscina, solarium e vista sul golfo di Policastro, a circa 1 km dal centro e dalla spiaggia.';
const path = paths.residence;

const services = [
  { icon: 'pool', title: 'Piscina', href: paths.pool },
  { icon: 'star', title: 'Animazione', href: `${paths.services}#animazione` },
  { icon: 'umbrella', title: 'Lido convenzionato', href: paths.beach },
  { icon: 'bus', title: 'Servizio navetta', href: paths.beach },
] as const;
---

<Base title={title} description={description} path={path}>
  <PageHero
    title="Il residence"
    lede="Case vacanze con piscina a Praia a Mare, sulla costa tirrenica calabrese, con vista sul golfo di Policastro."
    crumbs={[
      { href: '/', label: 'Home' },
      { label: 'Il residence' },
    ]}
    photo={photos.panorama}
    focus="50% 40%"
  />

  <section class="section">
    <div class="wrap">
      <div class="section-center reveal">
        <p class="kicker">Il residence</p>
        <h2>Case vacanze in residence a Praia a Mare</h2>
        <p>
          Il residence di nuova costruzione è a Praia a Mare, rinomata località balneare della costa tirrenica
          calabrese, a circa 1 km dal centro della cittadina e dall’ampia spiaggia di sabbia e ghiaia. Ha piscina e
          solarium, ed è in posizione tranquilla e panoramica, con vista sul golfo di Policastro.
        </p>
        <p class="actions">
          <a class="btn" href={`${paths.contact}#preventivo`}>Richiedi un preventivo</a>
          <a class="btn btn-ghost" href={paths.apartments}>Gli appartamenti</a>
        </p>
      </div>
      <MediaGroup
        photos={[
          { ...photos.panorama, focus: '30% 60%' },
          { ...photos.facciata, focus: '50% 40%' },
          { ...photos.piscina, focus: '50% 70%' },
        ]}
      />
    </div>
  </section>

  <section class="section section-sand" aria-labelledby="titolo-servizi">
    <div class="wrap">
      <header class="section-head reveal">
        <h2 id="titolo-servizi">Cosa c’è</h2>
      </header>
      <ul class="cards three">
        {
          services.map((service) => (
            <li class="card reveal">
              <Icon name={service.icon} />
              <h3>{service.title}</h3>
              <a class="more" href={service.href}>Scopri di più</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="titolo-mappa">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Piantina</p>
        <h2 id="titolo-mappa">Il residence, punto per punto</h2>
        <p class="lede">Tocca i numeri sulla foto per vedere cosa c’è.</p>
      </header>
      <div class="reveal">
        <ResidenceMap />
      </div>
    </div>
  </section>

  <Reviews tone="mist" />

  <Faq tag="apartments" />

  <NextPage to="residence" />

  <CloseBand />
</Base>
