---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CloseBand from '../../components/CloseBand.astro';
import { apartmentDetails, apartmentIntro, photos } from '../../data/site';

const title = 'Appartamenti del Residence Soleluna a Praia a Mare';
const description =
  '36 appartamenti al Residence Soleluna: bilocali, trilocali e quadrilocali con terrazzo, aria condizionata nel soggiorno e cucina componibile.';
const path = '/residence-case-vacanze-praia-a-mare/appartamenti-soleluna';
---

<Base title={title} description={description} path={path}>
  <PageHero
    title="Gli appartamenti"
    lede={apartmentIntro}
    tone="paper"
    crumbs={[
      { href: '/', label: 'Home' },
      { href: '/residence-case-vacanze-praia-a-mare', label: 'Il residence' },
      { label: 'Appartamenti' },
    ]}
    photo={photos.golfo}
  />
  <section class="stack">
    <div class="wrap">
      <p class="shot-note">Foto di soggiorno e terrazzo non presenti sul sito attuale. Qui c’è l’esterno, con piscina e appartamenti.</p>
      <div class="detail-grid">
        {
          apartmentDetails.map((group) => (
            <article class="info-card">
              <div>
                <h2>{group.title}</h2>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <CloseBand />
</Base>
