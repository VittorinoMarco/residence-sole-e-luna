---
import type { IconName } from '../data/site';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 44 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'pool' && (
      <>
        <path d="M14 30V12a4 4 0 0 1 8 0" />
        <path d="M26 30V12a4 4 0 0 1 8 0" />
        <path d="M14 20h12M26 20h8" />
        <path d="M6 36c3 0 3-2.5 6-2.5s3 2.5 6 2.5 3-2.5 6-2.5 3 2.5 6 2.5 3-2.5 6-2.5 3 2.5 6 2.5" />
        <path d="M6 42c3 0 3-2.5 6-2.5s3 2.5 6 2.5 3-2.5 6-2.5 3 2.5 6 2.5 3-2.5 6-2.5 3 2.5 6 2.5" />
      </>
    )
  }
  {
    name === 'star' && (
      <>
        <path d="M24 6l5.2 11 12 1.5-8.8 8.3 2.3 11.9L24 32.9 13.3 38.7l2.3-11.9L6.8 18.5l12-1.5z" />
      </>
    )
  }
  {
    name === 'umbrella' && (
      <>
        <path d="M6 24C6 14 14 7 24 7s18 7 18 17z" />
        <path d="M24 24v17" />
        <path d="M24 41h-5" />
        <path d="M15 24c0-6 4-14 9-17M33 24c0-6-4-14-9-17" />
      </>
    )
  }
  {
    name === 'bus' && (
      <>
        <rect x="8" y="9" width="32" height="27" rx="5" />
        <path d="M8 22h32" />
        <path d="M14 36v4M34 36v4" />
        <circle cx="15" cy="30" r="1.5" />
        <circle cx="33" cy="30" r="1.5" />
        <path d="M17 14h14" />
      </>
    )
  }
  {
    name === 'car' && (
      <>
        <path d="M9 30v-6l4-9a3 3 0 0 1 2.8-2h16.4a3 3 0 0 1 2.8 2l4 9v6" />
        <rect x="7" y="25" width="34" height="9" rx="3" />
        <path d="M11 34v4M37 34v4" />
        <circle cx="14" cy="29.5" r="1.4" />
        <circle cx="34" cy="29.5" r="1.4" />
        <path d="M13 24l2.5-6h17l2.5 6" />
      </>
    )
  }
  {
    name === 'play' && (
      <>
        <circle cx="24" cy="14" r="5" />
        <path d="M10 41l14-16 14 16" />
        <path d="M17 33h14" />
      </>
    )
  }
  {
    name === 'flame' && (
      <>
        <path d="M24 6c1 6-6 9-6 17a8 8 0 0 0 16 0c0-4-2-6-3-9-2 2-3 3-4 3 1-4 0-8-3-11z" />
        <path d="M14 42h20" />
      </>
    )
  }
  {
    name === 'wash' && (
      <>
        <rect x="9" y="6" width="30" height="36" rx="4" />
        <circle cx="24" cy="26" r="9" />
        <circle cx="15" cy="12" r="1.3" />
        <path d="M20 12h10" />
        <path d="M19 27c2-2 3 2 5 0s3 2 5 0" />
      </>
    )
  }
</svg>
