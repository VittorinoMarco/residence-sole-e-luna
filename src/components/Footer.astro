---
import { chapters, nav, site } from '../data/site';

interface Props {
  year: number;
}

const { year } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap footer-words">
    <p class="footer-label">Scopri il residence</p>
    {chapters.map((chapter) => <a href={chapter.href}>{chapter.word}</a>)}
  </div>
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">Soleluna</p>
      <p>
        Residence a Praia a Mare, sul golfo di Policastro.<br />
        <a href={site.map} rel="noopener noreferrer">{site.address.street}, {site.address.cap} {site.address.city}</a>
      </p>
    </div>
    <div>
      <p class="footer-label">Contatti</p>
      <ul class="footer-links">
        <li><a href={site.phones[0].href}>{site.phones[0].label}</a></li>
        <li><a href={site.phones[1].href}>{site.phones[1].label}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Il sito</p>
      <ul class="footer-links">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/blog">Blog</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Seguici</p>
      <ul class="footer-links">
        {site.social.map((item) => <li><a href={item.href} rel="noopener noreferrer">{item.label}</a></li>)}
        <li><a href={site.privacy} rel="noopener noreferrer">Privacy</a></li>
        <li><a href={site.cookies} rel="noopener noreferrer">Cookie</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap fine">
    <p>© {year} Residence Soleluna</p>
  </div>
</footer>
