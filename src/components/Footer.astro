---
import { site } from '../data/site';

interface Props {
  year: number;
}

const { year } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">Soleluna</p>
      <p>
        {site.address.street}<br />
        {site.address.cap} {site.address.city}<br />
        {site.address.country}
      </p>
    </div>
    <div>
      <p>
        <a href={site.phones[0].href}>{site.phones[0].label}</a><br />
        <a href={site.phones[1].href}>{site.phones[1].label}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <div>
      <p>
        {site.social.map((item) => (
          <a href={item.href} rel="noopener noreferrer">{item.label}</a>
        ))}
      </p>
      <p>
        <a href={site.privacy} rel="noopener noreferrer">Privacy</a><br />
        <a href={site.cookies} rel="noopener noreferrer">Cookie</a>
      </p>
    </div>
  </div>
  <div class="wrap fine">
    <p>© {year} Residence Soleluna</p>
  </div>
</footer>

<style>
  .site-footer a {
    display: inline;
    margin-right: 16px;
  }
</style>
