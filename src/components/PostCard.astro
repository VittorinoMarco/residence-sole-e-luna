---
import { dateLabel, minutes, type Post } from '../data/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li class="post-card reveal" data-category={post.category}>
  <a href={`/blog/${post.slug}`}>
    <div class="mask mask-tall no-parallax">
      <img src={post.photo.src} alt={post.photo.alt} loading="lazy" style={`object-position:${post.focus}`} />
    </div>
    <div class="post-meta">
      <span class="chip">{post.category}</span>
      <span>{dateLabel(post.date)} · {minutes(post)} min di lettura</span>
    </div>
    <h2 class="no-split">{post.title}</h2>
    <p>{post.excerpt}</p>
  </a>
</li>
