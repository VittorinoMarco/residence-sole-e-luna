---
import { site } from '../data/site';
---

<section class="band">
  <div class="wrap band-inner">
    <h2>Per info e prenotazioni</h2>
    <p>
      <a class="phone-link" href={site.phones[0].href}>{site.phones[0].label}</a>
    </p>
    <p class="actions">
      <a class="btn" href="/contatti#preventivo">Richiedi un preventivo</a>
      <a class="btn btn-sea" href={`mailto:${site.email}`}>Scrivi una email</a>
    </p>
  </div>
</section>
