---
import { paths, site } from '../data/site';
---

<section class="close-band" aria-labelledby="chiusura-titolo">
  <div class="wrap close-inner">
    <div>
      <h2 id="chiusura-titolo">Per info e prenotazioni</h2>
      <a class="phone-link" href={site.phones[0].href}>{site.phones[0].label}</a>
    </div>
    <p class="actions">
      <a class="btn" href={`${paths.contact}#preventivo`}>Richiedi un preventivo</a>
      <a class="btn btn-light" href={`mailto:${site.email}`}>Scrivi una email</a>
    </p>
  </div>
</section>
